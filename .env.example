# Copie este arquivo para .env e preencha os valores.

# URL de conexão do banco de desenvolvimento (PostgreSQL).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/igreja

# URL do banco de testes. Os testes apagam todas as tabelas dele: nunca aponte para o banco real.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/igreja_test

# Segredo para assinar a sessão de login. Use no mínimo 32 caracteres aleatórios.
SESSION_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres

# ID da conta do Cloudflare R2 (armazenamento de comprovantes).
R2_ACCOUNT_ID=

# Chave de acesso do R2.
R2_ACCESS_KEY_ID=

# Chave secreta do R2.
R2_SECRET_ACCESS_KEY=

# Nome do bucket do R2.
R2_BUCKET=

# Fuso horário usado nas datas do sistema.
TZ=America/Sao_Paulo
